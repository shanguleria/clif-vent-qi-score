# Site profiles hold local data paths — site-local, gitignored.
# Commit sites/*.example.json only; definitions/ is the shared spec and IS committed.
sites/*.json
!sites/*.example.json

# Generated outputs and intermediate data — output/<site>/intermediate_phi/ holds
